<Window x:Class="Mls203.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thorlabs MLS203 / UMC2" Height="760" Width="1180"
        MinHeight="480" MinWidth="640" WindowState="Maximized" Closing="Window_Closing">
    <Viewbox Stretch="Uniform">
    <Grid x:Name="LayoutRoot" Width="1180" Height="740" Margin="0" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Ethernet discovery" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="First IP"/>
                <TextBox x:Name="FirstIpBox" Grid.Column="1" Text="192.168.0.100"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Last IP"/>
                <TextBox x:Name="LastIpBox" Grid.Column="3" Text="192.168.0.100"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Port"/>
                <TextBox x:Name="PortBox" Grid.Column="5" Text="40303"/>
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Timeout (ms)"/>
                <TextBox x:Name="TimeoutBox" Grid.Column="7" Text="100"/>
                <Button x:Name="ScanButton" Grid.Column="8" Content="SCAN" Click="ScanButton_Click"/>
                <Button x:Name="ScanUsbButton" Grid.Column="9" Content="USB" Click="ScanUsbButton_Click"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Message Log" Grid.Column="1" Margin="4,0,0,0">
                <TextBox x:Name="MessageLogBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
            <GroupBox x:Name="DeviceListGroup" Header="Device List" Grid.Column="0" Margin="0,0,4,0">
                <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionChanged="DeviceGrid_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="Auto"/>
                        <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="Auto"/>
                        <DataGridTextColumn Header="Parent" Binding="{Binding ParentDevice}" Width="Auto"/>
                        <DataGridTextColumn Header="XA transport" Binding="{Binding TransportDisplay}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="205"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox x:Name="ConnectionGroup" Header="Connection" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="UMC2 ID"/>
                        <TextBox x:Name="DeviceIdBox" Grid.Column="1" MinWidth="105"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Click="ConnectButton_Click"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Transport"/>
                        <TextBox x:Name="TransportBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True"/>
                        <TextBlock x:Name="ProductText" Grid.Row="3" Grid.ColumnSpan="3" Margin="4,2"
                                   Foreground="#FF555555" FontSize="11" Height="30" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="POWER STATUS LED"/>
                            <Ellipse x:Name="PowerStatusLed" Width="18" Height="18" Margin="6"
                                     Fill="Gray" Stroke="DarkGray" ToolTip="Power status unavailable"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="LegendGroup" Header="LEGGENDA LED" Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="LED ASSI X / Y" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <DockPanel>
                                <Ellipse Fill="Gray" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Grigio: stato non disponibile / non connesso." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Red" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Rosso: errore asse." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Blue" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Blu lampeggiante: inizializzazione." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Purple" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Viola: alimentazione non pronta / spegnimento." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Orange" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Arancione: movimento o homing." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Green" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Verde: abilitato e fermo." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Blue" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Blu fisso: motore disabilitato." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Text="POWER STATUS LED" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <DockPanel>
                                <Ellipse Fill="Gray" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Grigio: connessione non disponibile." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Red" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Rosso: guasto tensione di alimentazione." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Green" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Verde: alimentazione OK su entrambi gli assi." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DockPanel>
                                <Ellipse Fill="Blue" Width="10" Height="10" Margin="0,2,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="Blu: inizializzazione / alimentazione non pronta." FontSize="10" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="205"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox x:Name="PositionGroup" Header="Position" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="X [mm]" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="XPositionText" Text="--" FontSize="36" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Y [mm]" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="YPositionText" Text="--" FontSize="36" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="Position polling [ms]"/>
                            <TextBox x:Name="PositionPollingMsBox" Width="70" Text="300"/>
                            <Button x:Name="ApplyPositionPollingButton" Content="Apply" Click="ApplyPositionPollingButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PositionFeedbackStatusText" Grid.Row="2" Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center" Foreground="#FF555555"
                                   Text="Feedback: waiting for connection"/>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="AxisControlsGroup" Header="Axis controls" Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Axis X" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Ellipse x:Name="XEnableLed" Width="18" Height="18" Margin="6"
                                         Fill="Gray" Stroke="DarkGray" ToolTip="X axis status unavailable"/>
                            </StackPanel>
                            <Button x:Name="HomeXButton" Content="Home X" Tag="X" IsEnabled="False" Click="HomeButton_Click"/>
                            <Button x:Name="EnableXButton" Content="Enable X" Tag="X" IsEnabled="False" Click="EnableAxisButton_Click"/>
                            <Button x:Name="DisableXButton" Content="Disable X" Tag="X" IsEnabled="False" Click="DisableAxisButton_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Axis Y" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Ellipse x:Name="YEnableLed" Width="18" Height="18" Margin="6"
                                         Fill="Gray" Stroke="DarkGray" ToolTip="Y axis status unavailable"/>
                            </StackPanel>
                            <Button x:Name="HomeYButton" Content="Home Y" Tag="Y" IsEnabled="False" Click="HomeButton_Click"/>
                            <Button x:Name="EnableYButton" Content="Enable Y" Tag="Y" IsEnabled="False" Click="EnableAxisButton_Click"/>
                            <Button x:Name="DisableYButton" Content="Disable Y" Tag="Y" IsEnabled="False" Click="DisableAxisButton_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="205"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox x:Name="AbsoluteMoveGroup" Header="Absolute move" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="X [mm]"/>
                        <TextBox x:Name="TargetXBox" Grid.Column="1" Text="0"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y [mm]"/>
                        <TextBox x:Name="TargetYBox" Grid.Column="3" Text="0"/>
                        <Button x:Name="MoveButton" Grid.Column="4" Content="Move XY" IsEnabled="False" Click="MoveButton_Click"/>
                        <TextBlock x:Name="SoftwareLimitsTextBlock" Grid.Row="1" Grid.ColumnSpan="5"
                                   Margin="4" Foreground="#FF555555" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="JogGroup" Header="Jog (relative move)" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="Step [mm]"/>
                        <TextBox x:Name="JogStepBox" Grid.Column="2" Text="1"/>
                        <Button x:Name="YPlusButton" Grid.Row="1" Grid.Column="1" Content="Y +" IsEnabled="False" Click="JogButton_Click" Tag="Y+"/>
                        <Button x:Name="XMinusButton" Grid.Row="2" Grid.Column="0" Content="X -" IsEnabled="False" Click="JogButton_Click" Tag="X-"/>
                        <Button x:Name="YMinusButton" Grid.Row="3" Grid.Column="1" Content="Y -" IsEnabled="False" Click="JogButton_Click" Tag="Y-"/>
                        <Button x:Name="StopButton" Grid.Row="2" Grid.Column="1" Content="STOP X+Y"
                                Background="#FFC62828" Foreground="White" FontWeight="Bold"
                                IsEnabled="False" Click="StopButton_Click"/>
                        <Button x:Name="XPlusButton" Grid.Row="2" Grid.Column="2" Content="X +" IsEnabled="False" Click="JogButton_Click" Tag="X+"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Margin="8" Padding="8" Background="#FFF0F2F5" CornerRadius="3">
            <TextBlock x:Name="StatusText" Text="Ready. Close the XA GUI before connecting from this application." TextWrapping="Wrap"/>
        </Border>
    </Grid>
    </Viewbox>
</Window>
