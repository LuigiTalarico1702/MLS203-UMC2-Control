<Window x:Class="Mls203.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thorlabs MLS203 / UMC2" Height="760" Width="1180"
        MinHeight="680" MinWidth="1020" WindowState="Maximized" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="100"/>
            <RowDefinition Height="*" MinHeight="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Ethernet discovery" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="First IP"/>
                <TextBox x:Name="FirstIpBox" Grid.Column="1" Text="192.168.0.100"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Last IP"/>
                <TextBox x:Name="LastIpBox" Grid.Column="3" Text="192.168.0.100"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Port"/>
                <TextBox x:Name="PortBox" Grid.Column="5" Text="40303"/>
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Timeout (ms)"/>
                <TextBox x:Name="TimeoutBox" Grid.Column="7" Text="100"/>
                <Button x:Name="ScanButton" Grid.Column="8" Content="SCAN" Click="ScanButton_Click"/>
                <Button x:Name="ScanUsbButton" Grid.Column="9" Content="USB" Click="ScanUsbButton_Click"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Message Log" Grid.Column="1" Margin="4,0,0,0">
                <TextBox x:Name="MessageLogBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
            <GroupBox x:Name="DeviceListGroup" Header="Device List" Grid.Column="0" Margin="0,0,4,0">
                <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionChanged="DeviceGrid_SelectionChanged"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="Auto"/>
                        <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="Auto"/>
                        <DataGridTextColumn Header="Parent" Binding="{Binding ParentDevice}" Width="Auto"/>
                        <DataGridTextColumn Header="XA transport" Binding="{Binding TransportDisplay}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="313"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox x:Name="ConnectionGroup" Header="Connection" Height="159">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="UMC2 ID"/>
                        <TextBox x:Name="DeviceIdBox" Grid.Column="1" MinWidth="105"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Click="ConnectButton_Click"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Transport"/>
                        <TextBox x:Name="TransportBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True"/>
                        <TextBlock x:Name="ProductText" Grid.Row="2" Grid.ColumnSpan="3" Margin="4,2"
                                   Foreground="#FF555555" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

            </StackPanel>

            <StackPanel Grid.Column="1">
                <GroupBox x:Name="PositionGroup" Header="Position" Height="159">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="X [mm]" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="XPositionText" Text="--" FontSize="36" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Y [mm]" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="YPositionText" Text="--" FontSize="36" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="Position polling [ms]"/>
                            <TextBox x:Name="PositionPollingMsBox" Width="70" Text="300"/>
                            <Button x:Name="ApplyPositionPollingButton" Content="Apply" Click="ApplyPositionPollingButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PositionFeedbackStatusText" Grid.Row="2" Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center" Foreground="#FF555555"
                                   Text="Feedback: waiting for connection"/>
                    </Grid>
                </GroupBox>
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="POWER STATUS LED"/>
                    <Ellipse x:Name="PowerStatusLed" Grid.Row="0" Grid.Column="2" Width="18" Height="18" Margin="6"
                             VerticalAlignment="Center" Fill="Gray" Stroke="DarkGray" StrokeThickness="1"
                             ToolTip="Power status unavailable"/>
                    <Button x:Name="HomeButton" Grid.Row="1" Grid.Column="0" Content="Home X + Y"
                            IsEnabled="False" Click="HomeButton_Click"/>
                    <Button x:Name="EnableXButton" Grid.Row="2" Grid.Column="0" Content="Enable X"
                            IsEnabled="False" Click="EnableAxisButton_Click" Tag="X"/>
                    <Button x:Name="DisableXButton" Grid.Row="2" Grid.Column="1" Content="Disable X"
                            IsEnabled="False" Click="DisableAxisButton_Click" Tag="X"/>
                    <Ellipse x:Name="XEnableLed" Grid.Row="2" Grid.Column="2" Width="18" Height="18" Margin="6"
                             VerticalAlignment="Center" Fill="Gray" Stroke="DarkGray" StrokeThickness="1"
                             ToolTip="X axis status unavailable"/>
                    <Button x:Name="EnableYButton" Grid.Row="3" Grid.Column="0" Content="Enable Y"
                            IsEnabled="False" Click="EnableAxisButton_Click" Tag="Y"/>
                    <Button x:Name="DisableYButton" Grid.Row="3" Grid.Column="1" Content="Disable Y"
                            IsEnabled="False" Click="DisableAxisButton_Click" Tag="Y"/>
                    <Ellipse x:Name="YEnableLed" Grid.Row="3" Grid.Column="2" Width="18" Height="18" Margin="6"
                             VerticalAlignment="Center" Fill="Gray" Stroke="DarkGray" StrokeThickness="1"
                             ToolTip="Y axis status unavailable"/>
                    <Button x:Name="StopButton" Grid.Row="1" Grid.Column="1" Content="STOP"
                            Background="#FFC62828" Foreground="White"
                            FontWeight="Bold" IsEnabled="False" Click="StopButton_Click"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <GroupBox x:Name="AbsoluteMoveGroup" Header="Absolute move" Height="159">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="X [mm]"/>
                        <TextBox x:Name="TargetXBox" Grid.Column="1" Text="0"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y [mm]"/>
                        <TextBox x:Name="TargetYBox" Grid.Column="3" Text="0"/>
                        <Button x:Name="MoveButton" Grid.Column="4" Content="Move XY" IsEnabled="False" Click="MoveButton_Click"/>
                        <TextBlock x:Name="SoftwareLimitsTextBlock" Grid.Row="1" Grid.ColumnSpan="5"
                                   Margin="4" Foreground="#FF555555"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Jog (relative move)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="Step [mm]"/>
                        <TextBox x:Name="JogStepBox" Grid.Column="2" Text="1"/>
                        <Button x:Name="YPlusButton" Grid.Row="1" Grid.Column="1" Content="Y +" IsEnabled="False" Click="JogButton_Click" Tag="Y+"/>
                        <Button x:Name="XMinusButton" Grid.Row="2" Grid.Column="0" Content="X −" IsEnabled="False" Click="JogButton_Click" Tag="X-"/>
                        <Button x:Name="YMinusButton" Grid.Row="2" Grid.Column="1" Content="Y −" IsEnabled="False" Click="JogButton_Click" Tag="Y-"/>
                        <Button x:Name="XPlusButton" Grid.Row="2" Grid.Column="2" Content="X +" IsEnabled="False" Click="JogButton_Click" Tag="X+"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Margin="8" Padding="8" Background="#FFF0F2F5" CornerRadius="3">
            <TextBlock x:Name="StatusText" Text="Ready. Close the XA GUI before connecting from this application." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
