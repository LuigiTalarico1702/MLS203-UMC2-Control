<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MLS203.Control</AssemblyName>
    <RootNamespace>Mls203.Control</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="tlmc_xa_dotnet">
      <HintPath>lib\tlmc_xa_dotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lib\tlmc_xa_native.dll" Condition="Exists('lib\tlmc_xa_native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- DllImport resolves native dependencies beside the executable. -->
      <TargetPath>tlmc_xa_native.dll</TargetPath>
    </None>
  </ItemGroup>
</Project>
